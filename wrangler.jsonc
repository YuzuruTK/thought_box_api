{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thought-box-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  // D1 database binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thought_box",
      "database_id": "80cee6ae-05fb-4f61-9b89-a364477a02fb",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Workers AI binding. The model is configured below.
  "ai": {
    "binding": "AI"
  },
  // JWT signing secret and provider secrets are configured with `wrangler secret put`.
  // For local development, put them in `.dev.vars`.
  "vars": {
    // Primary platform model. Qwen3 30B A3B has a 32K context window and
    // comparatively low Neuron consumption for its capability level.
    "WORKERS_AI_MODEL": "@cf/ibm-granite/granite-4.0-h-micro",
    // Direct Google Gemini standby model.
    "GEMINI_MODEL": "gemini-3.7-flash"
  },
  // Hourly cron that refreshes stale box summaries.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Static assets for the web client (built from client/ with Vite).
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
