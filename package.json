{
  "name": "thought-box-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:api": "wrangler dev",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply thought_box --local",
    "db:migrate:remote": "wrangler d1 migrations apply thought_box --remote",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix client run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260820.1": true
  }
}
